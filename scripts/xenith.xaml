<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xenith - Victory-NVIDIA" Width="1180" Height="780" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#0C0D18" Foreground="#E9EAF5"
        FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="BgBrush" Color="#0C0D18"/>
    <SolidColorBrush x:Key="SideBrush" Color="#090A13"/>
    <SolidColorBrush x:Key="CardBrush" Color="#16172A"/>
    <SolidColorBrush x:Key="FieldBrush" Color="#1D1E33"/>
    <SolidColorBrush x:Key="LineBrush" Color="#25263D"/>
    <SolidColorBrush x:Key="MintBrush" Color="#9BF0CF"/>
    <SolidColorBrush x:Key="PinkBrush" Color="#F29BDA"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E9EAF5"/>
    <SolidColorBrush x:Key="DimBrush" Color="#9396B3"/>

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{StaticResource FieldBrush}" BorderBrush="#33355A" BorderThickness="1"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#262842"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#4A4D7C"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#5B5E7E"/>
                <Setter Property="Cursor" Value="Arrow"/>
                <Setter TargetName="Bd" Property="Background" Value="#12132A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="10,0"/>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="#1A0F2A" BorderBrush="{StaticResource PinkBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="20,12">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#2E1A44"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PlayButton" TargetType="Button">
      <Setter Property="Foreground" Value="#0B2A1F"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{StaticResource MintBrush}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#5B5E7E"/>
                <Setter TargetName="Bd" Property="Background" Value="#22243C"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="StopButton" TargetType="Button">
      <Setter Property="Foreground" Value="#FFB4B8"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="#3A1B24" BorderBrush="#7A3340" BorderThickness="1" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#4A2230"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#5B5E7E"/>
                <Setter TargetName="Bd" Property="Background" Value="#22243C"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#33355A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Root" Background="Transparent" Height="52">
              <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Background="{StaticResource PinkBrush}" Visibility="Collapsed"/>
              <ContentPresenter VerticalAlignment="Center" Margin="34,0,0,0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
              </Trigger>
              <Trigger Property="Tag" Value="active">
                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Root" Property="Background" Value="#15111F"/>
                <Setter Property="Foreground" Value="{StaticResource PinkBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ContentPresenter VerticalAlignment="Center"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="#33355A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CaretBrush" Value="{StaticResource MintBrush}"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource MintBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" Background="{StaticResource FieldBrush}"
                      BorderBrush="#4A4D7C" BorderThickness="1" VerticalAlignment="Center">
                <Path x:Name="Tick" Data="M0,4 L3.5,7.5 L10,0" Stroke="#0B2A1F" StrokeThickness="2"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource MintBrush}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource MintBrush}"/>
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Padding" Value="10,0,4,0"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{StaticResource FieldBrush}" BorderBrush="#33355A" BorderThickness="1" CornerRadius="6">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                        <Path Grid.Column="1" Data="M0,0 L4.5,4.5 9,0" Stroke="{StaticResource MintBrush}" StrokeThickness="2"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="#262842"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter IsHitTestVisible="False" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Placement="Bottom"
                     PopupAnimation="Slide" Focusable="False">
                <Border Background="#1B1C33" BorderBrush="#33355A" BorderThickness="1" CornerRadius="8" Margin="0,2,0,8"
                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter Margin="4"/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                  <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="#262842"/>
                      <Setter Property="Foreground" Value="{StaticResource MintBrush}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="22,18"/>
    </Style>
    <Style x:Key="Kicker" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource PinkBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- sidebar -->
    <Border Grid.Column="0" Background="{StaticResource SideBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="34,36,22,0">
          <TextBlock Text="XENITH" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF"/>
          <TextBlock Text="(VICTORY-NVIDIA)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DimBrush}" Margin="1,2,0,0"/>
          <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,24,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,22,0,0">
          <Button x:Name="NavOverview" Style="{StaticResource NavButton}" Content="Overview" Tag="active"/>
          <Button x:Name="NavNotes" Style="{StaticResource NavButton}" Content="Patch notes"/>
          <Button x:Name="NavConsole" Style="{StaticResource NavButton}" Content="Console"/>
          <Button x:Name="NavWebsite" Style="{StaticResource NavButton}" Content="Website"/>
        </StackPanel>
        <Border Grid.Row="2" Margin="22,0,18,24" Background="#12132A" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="10" Padding="12,10">
          <StackPanel>
            <TextBlock Text="GRAPHICS CARD" Style="{StaticResource Kicker}" Foreground="{StaticResource DimBrush}"/>
            <TextBlock x:Name="GpuBadge" Text="looking for the card..." TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- main -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border x:Name="NoticeBar" Grid.Row="0" Visibility="Collapsed" Margin="40,16,40,0" Padding="14,10"
              CornerRadius="8" BorderThickness="1" Background="#2A1519" BorderBrush="#7A3340">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="NoticeText" TextWrapping="Wrap" VerticalAlignment="Center"/>
          <Button x:Name="NoticeClose" Grid.Column="1" Style="{StaticResource LinkButton}" Content="Dismiss" Margin="14,0,0,0"/>
        </Grid>
      </Border>

      <!-- overview -->
      <Grid x:Name="ViewOverview" Grid.Row="1" Margin="40,28,40,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="300"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>

          <Border Grid.Column="0" CornerRadius="16" ClipToBounds="True">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0.7,1">
                <GradientStop Color="#2B2250" Offset="0"/>
                <GradientStop Color="#7A4A86" Offset="0.45"/>
                <GradientStop Color="#C9718F" Offset="0.72"/>
                <GradientStop Color="#2A1B33" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <Grid>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,48,60">
                <Rectangle Width="30" Height="120" Margin="0,0,3,0" VerticalAlignment="Bottom" Fill="#CC1A1430"/>
                <Rectangle Width="30" Height="200" Margin="0,0,3,0" VerticalAlignment="Bottom" Fill="#CC1A1430"/>
                <Rectangle Width="30" Height="150" Margin="0,0,3,0" VerticalAlignment="Bottom" Fill="#CC1A1430"/>
                <Rectangle Width="34" Height="270" Margin="0,0,3,0" VerticalAlignment="Bottom" Fill="#CC1A1430"/>
                <Rectangle Width="30" Height="180" Margin="0,0,3,0" VerticalAlignment="Bottom" Fill="#CC1A1430"/>
                <Rectangle Width="36" Height="310" Margin="0,0,3,0" VerticalAlignment="Bottom" Fill="#CC1A1430"/>
                <Rectangle Width="30" Height="220" Margin="0,0,3,0" VerticalAlignment="Bottom" Fill="#CC1A1430"/>
                <Rectangle Width="30" Height="140" Margin="0,0,3,0" VerticalAlignment="Bottom" Fill="#CC1A1430"/>
                <Rectangle Width="30" Height="190" Margin="0,0,3,0" VerticalAlignment="Bottom" Fill="#CC1A1430"/>
                <Rectangle Width="30" Height="110" Margin="0,0,3,0" VerticalAlignment="Bottom" Fill="#CC1A1430"/>
                <Rectangle Width="30" Height="160" Margin="0,0,3,0" VerticalAlignment="Bottom" Fill="#CC1A1430"/>
              </StackPanel>
              <Rectangle VerticalAlignment="Bottom" Height="70">
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00150F20" Offset="0"/>
                    <GradientStop Color="#EE150F20" Offset="1"/>
                  </LinearGradientBrush>
                </Rectangle.Fill>
              </Rectangle>
              <Rectangle>
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#E00C0D18" Offset="0"/>
                    <GradientStop Color="#A00C0D18" Offset="0.35"/>
                    <GradientStop Color="#00000000" Offset="0.75"/>
                  </LinearGradientBrush>
                </Rectangle.Fill>
              </Rectangle>
              <Grid Margin="40,34,40,34">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" HorizontalAlignment="Left" CornerRadius="16" BorderThickness="1"
                        BorderBrush="#9A5A9A" Background="#33150F20" Padding="16,7">
                  <TextBlock Text="COMMUNITY LAUNCHER" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PinkBrush}"/>
                </Border>
                <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                  <TextBlock FontSize="60" FontWeight="Bold">
                    <Run Text="VIctory" Foreground="#FFFFFF"/><Run Text="-NVIDIA" Foreground="{StaticResource MintBrush}"/>
                  </TextBlock>
                  <TextBlock Text="R U N   O N   A N   R T X   C A R D" FontSize="14" Foreground="{StaticResource MintBrush}" Margin="3,4,0,0"/>
                  <TextBlock Text="Custom Xenith launcher for the VIctory compatibility runtime." FontSize="15" Margin="3,18,0,0" Foreground="#D6D8EC"/>
                </StackPanel>
                <Button x:Name="BtnCommunity" Grid.Row="3" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                        Margin="0,26,0,0" Content="Explore community  &#x2197;"/>
              </Grid>
            </Grid>
          </Border>

          <Border Grid.Column="1" Style="{StaticResource Card}" Margin="20,0,0,0" Padding="28,26">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Ellipse x:Name="StateDot" Grid.Row="0" Width="9" Height="9" HorizontalAlignment="Left" Fill="#9396B3" Margin="0,0,0,14"/>
              <StackPanel Grid.Row="1">
                <TextBlock x:Name="StateTitle" Text="Checking..." FontSize="28" FontWeight="SemiBold"/>
                <TextBlock x:Name="StateSub" Text="" Foreground="{StaticResource DimBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
              </StackPanel>
              <Grid Grid.Row="2" Margin="0,24,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="BtnPlay" Grid.Column="0" Style="{StaticResource PlayButton}" Height="58" FontSize="17" IsEnabled="False">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="M0,0 L12,7 L0,14 Z" Fill="#0B2A1F" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="PLAY" FontWeight="Bold"/>
                  </StackPanel>
                </Button>
                <Button x:Name="BtnStop" Grid.Column="0" Style="{StaticResource StopButton}" Height="58" FontSize="17"
                        Content="STOP" Visibility="Collapsed"/>
                <Button x:Name="BtnSettings" Grid.Column="1" Width="58" Height="58" Margin="12,0,0,0"
                        FontFamily="Segoe UI Symbol" FontSize="22" Content="&#x2699;" ToolTip="Settings"/>
              </Grid>
              <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,8,0,8">
                <StackPanel x:Name="HealthList"/>
              </ScrollViewer>
              <StackPanel Grid.Row="4">
                <TextBlock Text="LAUNCHER VERSION" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DimBrush}"/>
                <TextBlock x:Name="VersionText" Text="..." Margin="0,4,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,26,0,12">
          <TextBlock Text="Latest from Victory-NVIDIA" FontSize="20" FontWeight="SemiBold"/>
          <Button x:Name="LinkAllNotes" Style="{StaticResource LinkButton}" Content="View all patch notes  &#x2197;"
                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <UniformGrid Grid.Row="2" Columns="3" Height="170" Margin="0,0,0,14">
          <Border x:Name="CardSetup" Style="{StaticResource Card}" Margin="0,0,8,0" Cursor="Hand">
            <StackPanel>
              <TextBlock Text="SETUP" Style="{StaticResource Kicker}"/>
              <TextBlock x:Name="CardSetupTitle" Text="Checking..." FontSize="19" FontWeight="SemiBold" Margin="0,12,0,0"/>
              <TextBlock x:Name="CardSetupBody" Foreground="{StaticResource DimBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
          <Border x:Name="CardRun" Style="{StaticResource Card}" Margin="8,0" Cursor="Hand">
            <StackPanel>
              <TextBlock Text="THE PLAY SET" Style="{StaticResource Kicker}"/>
              <TextBlock x:Name="CardRunTitle" Text="..." FontSize="19" FontWeight="SemiBold" Margin="0,12,0,0"/>
              <TextBlock x:Name="CardRunBody" Foreground="{StaticResource DimBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
          <Border x:Name="CardNotes" Style="{StaticResource Card}" Margin="8,0,0,0" Cursor="Hand">
            <StackPanel>
              <TextBlock Text="PATCH NOTES" Style="{StaticResource Kicker}"/>
              <TextBlock x:Name="CardNotesTitle" Text="..." FontSize="19" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap"/>
              <TextBlock x:Name="CardNotesBody" Foreground="{StaticResource MintBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
        </UniformGrid>
      </Grid>

      <!-- patch notes -->
      <ScrollViewer x:Name="ViewNotes" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="40,28,40,0">
        <StackPanel>
          <TextBlock Text="Patch notes" Style="{StaticResource SectionTitle}"/>
          <StackPanel x:Name="NotesList"/>
        </StackPanel>
      </ScrollViewer>

      <!-- console -->
      <Grid x:Name="ViewConsole" Grid.Row="1" Visibility="Collapsed" Margin="40,28,40,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Console" Style="{StaticResource SectionTitle}"/>
        <Grid Grid.Row="1" Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="LogPath" Grid.Column="0" Style="{StaticResource Label}" Text="the latest run's log shows here"
                     TextTrimming="CharacterEllipsis" FontSize="12"/>
          <Button x:Name="BtnLogSave" Grid.Column="1" Content="Save log..." Margin="10,0,0,0"/>
          <Button x:Name="BtnLogCopy" Grid.Column="2" Content="Copy" Margin="8,0,0,0"/>
          <Button x:Name="BtnLogFolder" Grid.Column="3" Content="Open log folder" Margin="8,0,0,0"/>
        </Grid>
        <Border Grid.Row="2" Background="#090A13" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10">
          <TextBox x:Name="LogBox" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="Consolas"
                   FontSize="12" Padding="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                   TextWrapping="NoWrap" AcceptsReturn="True"/>
        </Border>
      </Grid>

      <!-- settings -->
      <ScrollViewer x:Name="ViewSettings" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="40,28,40,0">
        <StackPanel>
          <TextBlock Text="Settings" Style="{StaticResource SectionTitle}"/>

          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="TITLE" Style="{StaticResource Kicker}" Margin="0,0,0,8"/>
              <Grid Margin="0,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Label}" Text="Game exe"/>
                <TextBox Grid.Column="1" x:Name="TxtGame"/>
                <Button Grid.Column="2" x:Name="BtnGameBrowse" Content="Browse..." Margin="8,0,0,0"/>
              </Grid>
              <Grid Margin="0,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="260"/><ColumnDefinition Width="30"/><ColumnDefinition Width="110"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Label}" Text="Console"/>
                <ComboBox Grid.Column="1" x:Name="CmbConsole">
                  <ComboBoxItem Content="Series S (1080p out, faster)" Tag="S"/>
                  <ComboBoxItem Content="Series X (2160p out)" Tag="X"/>
                </ComboBox>
                <TextBlock Grid.Column="3" Style="{StaticResource Label}" Text="Render height"/>
                <ComboBox Grid.Column="4" x:Name="CmbRes">
                  <ComboBoxItem Content="720p (tight, recommended)" Tag="720"/>
                  <ComboBoxItem Content="1080p (legacy)" Tag="1080"/>
                </ComboBox>
              </Grid>
              <Grid Margin="0,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Label}" Text="Runtime build"/>
                <ComboBox Grid.Column="1" x:Name="CmbBuild">
                  <ComboBoxItem Content="diag (measured build)" Tag="diag"/>
                  <ComboBoxItem Content="release (faster)" Tag="release"/>
                </ComboBox>
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="PICTURE AND CARD" Style="{StaticResource Kicker}" Margin="0,0,0,8"/>
              <Grid Margin="0,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Label}" Text="Adapter"/>
                <ComboBox Grid.Column="1" x:Name="CmbAdapter"/>
                <Button Grid.Column="2" x:Name="BtnDetect" Content="Detect" Margin="8,0,0,0"/>
              </Grid>
              <Grid Margin="0,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Label}" Text="Upscaler"/>
                <ComboBox Grid.Column="1" x:Name="CmbUpscaler">
                  <ComboBoxItem Content="The fork's own (default)" Tag=""/>
                  <ComboBoxItem Content="DLSS (the title's FSR path; NGX files from the DLSS folder)" Tag="dlss"/>
                </ComboBox>
              </Grid>
              <WrapPanel Margin="0,12,0,0">
                <CheckBox x:Name="ChkQuality" Content="Quality patches (costs fps)" Margin="0,0,28,6"/>
                <CheckBox x:Name="ChkRay" Content="Ray tracing on (slower)" Margin="0,0,28,6"/>
                <CheckBox x:Name="ChkPreload" Content="Preload shaders before each run (minutes, once)" Margin="0,0,28,6"/>
                <CheckBox x:Name="ChkMinimize" Content="Minimize the launcher when the game starts" Margin="0,0,0,6"/>
              </WrapPanel>
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <CheckBox x:Name="ChkPerfLog" Content="Perf log (stability monitoring)" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Style="{StaticResource Label}" Text="Sample every" Margin="18,0,8,0"/>
                <TextBox Grid.Column="2" x:Name="TxtPerfInterval" Width="54" Text="1" HorizontalContentAlignment="Center"/>
                <TextBlock Grid.Column="3" Style="{StaticResource Label}" Text="seconds, for the full run; CSV saved in the log folder" Margin="8,0,0,0"/>
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="FILES" Style="{StaticResource Kicker}" Margin="0,0,0,8"/>
              <Grid Margin="0,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Label}" Text="Cache folder"/>
                <TextBox Grid.Column="1" x:Name="TxtCache"/>
                <Button Grid.Column="2" x:Name="OpenCache" Content="Open" Margin="8,0,0,0"/>
                <Button Grid.Column="3" x:Name="PickCache" Content="Change..." Margin="8,0,0,0"/>
              </Grid>
              <Grid Margin="0,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Label}" Text="Saves folder"/>
                <TextBox Grid.Column="1" x:Name="TxtSaves"/>
                <Button Grid.Column="2" x:Name="OpenSaves" Content="Open" Margin="8,0,0,0"/>
                <Button Grid.Column="3" x:Name="PickSaves" Content="Change..." Margin="8,0,0,0"/>
              </Grid>
              <Grid Margin="0,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Label}" Text="DLSS folder"/>
                <TextBox Grid.Column="1" x:Name="TxtDlss"/>
                <Button Grid.Column="2" x:Name="OpenDlss" Content="Open" Margin="8,0,0,0"/>
                <Button Grid.Column="3" x:Name="PickDlss" Content="Change..." Margin="8,0,0,0"/>
              </Grid>
              <Grid Margin="0,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Label}" Text="Log folder"/>
                <TextBox Grid.Column="1" x:Name="TxtLogDir"/>
                <Button Grid.Column="2" x:Name="OpenLogDir" Content="Open" Margin="8,0,0,0"/>
                <Button Grid.Column="3" x:Name="PickLogDir" Content="Change..." Margin="8,0,0,0"/>
              </Grid>
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
            <Button x:Name="BtnSave" Content="Save settings" Width="140" Height="40"/>
            <Button x:Name="BtnRevert" Content="Revert" Width="100" Height="40" Margin="10,0,0,0"/>
            <Button x:Name="BtnBack" Content="Back to overview" Height="40" Margin="10,0,0,0"/>
            <TextBlock x:Name="SettingsMsg" Style="{StaticResource Label}" Margin="16,0,0,0"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- footer -->
      <Grid Grid.Row="2" Margin="40,10,40,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="LinkSupport" Style="{StaticResource LinkButton}" Content="Support  &#x2197;" FontSize="12"/>
          <Button x:Name="LinkPolicy" Style="{StaticResource LinkButton}" Content="Asset policy  &#x2197;" FontSize="12" Margin="20,0,0,0"/>
        </StackPanel>
        <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="10.5" Foreground="#6C6F92" Margin="24,0,24,0" VerticalAlignment="Center"
                   Text="Bring your own files: this runtime supplies nothing of the game. A compatibility layer, not affiliated with or endorsed by Microsoft, Rockstar Games or any publisher. GPL-3.0-or-later."/>
        <TextBlock x:Name="FooterVer" Grid.Column="2" FontSize="11" Foreground="#6C6F92" VerticalAlignment="Center"/>
      </Grid>
    </Grid>
  </Grid>
</Window>
